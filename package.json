{
  "name": "petstareai",
  "version": "1.0.0",
  "description": "A desktop pet that monitors your AI tools",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite & electron .",
    "electron:build": "vite build && electron-builder",
    "package": "electron-builder"
  },
  "keywords": [
    "desktop-pet",
    "ai",
    "monitoring",
    "electron",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lottie-react": "^2.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.petstareai.app",
    "productName": "PetStareAI",
    "asar": true,
    "asarUnpack": [],
    "compression": "maximum",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "PetStareAI",
      "icon": "assets/icon.icns",
      "iconSize": 80,
      "contents": [
        { "x": 150, "y": 150 },
        { "x": 400, "y": 150, "type": "link", "path": "/Applications" },
        { "x": 275, "y": 300, "type": "file", "path": "安装说明.txt" }
      ],
      "window": {
        "width": 550,
        "height": 400
      }
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "!**/.git/**",
      "!**/.github/**",
      "!node_modules/**",
      "!**/node_modules/**",
      "!*.log",
      "!*.md",
      "!*.markdown",
      "!*.yml",
      "!*.yaml",
      "!*.json.lock",
      "!LICENSE",
      "!LICENSE.txt",
      "!.claude/**",
      "!.vscode/**",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.d.ts"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ]
    }
  }
}
